.include "M328PDEF.inc"
.cseg
.org 0x0000


SETUP:
	// Configurar Prescaler "Principal"
    LDI R16, (1 << CLKPCE)
    STS CLKPR, R16             ; Habilitar cambio de PRESCALER
    LDI R16, 0b00000100
    STS CLKPR, R16             ; Configurar Prescaler a 16 F_cpu = 1MHz

    LDI R16, 0x00
    OUT DDRC, R16              ; Configura PORTC como entrada
    LDI R16, 0xFF
    OUT PORTC, R16             ; Habilitar resistencias pull-up en PORTC

    LDI R16, 0xFF
    OUT DDRD, R16              ; Configura PORTD como salida
    LDI R16, 0x00
    OUT PORTD, R16             ; Inicializa PORTD en 0

    LDI R16, 0xFF
    OUT DDRB, R16              ; Configura PORTB como salida para la suma y el carry
    LDI R16, 0x00
    OUT PORTB, R16             ; Inicializa PORTB en 0

    LDI R20, 0x00              ; Contador 1 (bajo)
    LDI R21, 0x00              ; Contador 2 (alto)
    LDI R17, 0xFF              ; Estado inicial de los botones

LOOP:
    IN R16, PINC               ; Leer el estado de los botones
    CP R17, R16                ; Comparar con el estado anterior
    BREQ LOOP                  ; Si no hay cambios, continuar en el bucle

    CALL DELAY                 ; Antirebote

    IN R16, PINC               ; Leer de nuevo después del delay
    CP R17, R16
    BREQ LOOP                  ; Confirmar el cambio
    MOV R17, R16               ; Guardar el nuevo estado de los botones

    ; Control del Contador 1 (Bits 0 y 1)
    SBRC R16, 1
    RJMP SKIP_INCR1
    CALL INCR1
	SKIP_INCR1:

    SBRC R16, 0
    RJMP SKIP_DECR1
    CALL DECR1
	SKIP_DECR1:

    ; Control del Contador 2 (Bits 2 y 3)
    SBRC R16, 3
    RJMP SKIP_INCR2
    CALL INCR2
	SKIP_INCR2:

    SBRC R16, 2
    RJMP SKIP_DECR2
    CALL DECR2
	SKIP_DECR2:

    ; Botón de Suma (PC4)
    SBRC R16, 4
    RJMP LOOP
    CALL SUMA

    RJMP LOOP


INCR1:
    INC R20
    ANDI R20, 0x0F       ; Limitar a 4 bits
    CALL UPDATE_PORTD
    RET

DECR1:
    DEC R20
    ANDI R20, 0x0F       ; Limitar a 4 bits
    CALL UPDATE_PORTD
    RET
	
INCR2:
    INC R21
    ANDI R21, 0x0F       ; Limitar a 4 bits 
    CALL UPDATE_PORTD
    RET

DECR2:
    DEC R21
    ANDI R21, 0x0F       ; Limitar a 4 bits 
    CALL UPDATE_PORTD
    RET

UPDATE_PORTD:
    MOV R22, R20         ; Copiar el contador 1 al nibble bajo
    MOV R23, R21         ; Copiar el contador 2

    LSL R23              ; Desplazar 4 bits hacia la izquierda 
    LSL R23
    LSL R23
    LSL R23

    OR R22, R23          ; Combinar ambos contadores
    OUT PORTD, R22       ; Actualizar el puerto D
    RET

SUMA:
    MOV R24, R20               ; Copiar el contador 1 a R24
    ADD R24, R21               ; Sumar los dos contadores

    ; Mostrar el resultado  en PORTB 
    ANDI R24, 0x0F             ; Limitar el resultado a 4 bits
    OUT PORTB, R24             ; Mostrar el resultado de la suma
    RET           


DELAY:
		LDI R18, 0
	SUBDELAY1:
		INC R18
		CPI R18, 0
		BRNE SUBDELAY1
		LDI R18, 0
	SUBDELAY2:
		INC R18
		CPI R18, 0
		BRNE SUBDELAY2
		LDI R18, 0
	SUBDELAY3:
		INC R18
		CPI R18, 0
		BRNE SUBDELAY3
	RET
